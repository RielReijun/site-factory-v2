{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Site Factory v2 SitePlan",
  "type": "object",
  "required": ["slug", "company_name", "theme", "pages", "sections"],
  "properties": {
    "slug": { "type": "string" },
    "company_name": { "type": "string" },
    "source_url": { "type": "string" },
    "contact": {
      "type": "object",
      "properties": {
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "website": { "type": "string" }
      }
    },
    "theme": {
      "type": "object",
      "required": ["primary", "secondary", "accent", "background", "text"],
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "string" },
        "accent": { "type": "string" },
        "background": { "type": "string" },
        "text": { "type": "string" },
        "font_heading": { "type": "string" },
        "font_body": { "type": "string" }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "title"],
        "properties": {
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "content"],
        "properties": {
          "type": { "type": "string" },
          "variant": { "type": "string" },
          "content": { "type": "object" }
        }
      }
    }
  }
}
