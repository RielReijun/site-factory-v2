---
import "../styles/site.css";
import sitePlan from "../data/sitePlan.json";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";

const { title, description } = Astro.props;
const pageTitle = title || sitePlan.company_name;
const pageDescription = description || sitePlan.tagline || sitePlan.company_name;
const theme = sitePlan.theme || {};

// Typography uit inventory: heading + body font-stack. Default Playfair+Inter
// als de extractor niets gevonden heeft.
const typography = sitePlan.typography || {};
const headingFont = typography.heading_font || "Playfair Display";
const bodyFont    = typography.body_font || "Inter";
const headingStack = `"${headingFont}", "Playfair Display", "Cormorant Garamond", Georgia, serif`;
const bodyStack    = `"${bodyFont}", "Inter", "Lato", system-ui, -apple-system, "Segoe UI", sans-serif`;

// Google Fonts URL bouwen voor extracted fonts. Als geen extracted, fallback
// op Playfair+Inter (zoals voorheen).
const googleFonts = (typography.google_fonts && typography.google_fonts.length > 0)
  ? typography.google_fonts
  : ["Playfair Display", "Inter"];
const fontFamilies = googleFonts.map((f) => `family=${f.replace(/ /g, "+")}:wght@300;400;500;600;700`).join("&");
const googleFontsUrl = `https://fonts.googleapis.com/css2?${fontFamilies}&display=swap`;

// Personality-vars uit inventory: radius/shadow/padding/heading-weight.
const personality = (sitePlan.variants && sitePlan.variants.personality) || {};
const cardRadius     = personality.border_radius || "10px";
const buttonRadius   = personality.button_radius || "4px";
const sectionPadding = personality.section_padding || "96px";
const shadowStyle    = personality.shadow || "soft";   // 'none' | 'soft' | 'dramatic'
const headingWeight  = String(personality.heading_weight || 500);

// Schaduw-CSS afhankelijk van personality.shadow
const shadowSm = shadowStyle === "none"     ? "none"
                : shadowStyle === "dramatic" ? "0 2px 4px rgba(0,0,0,0.10), 0 8px 16px rgba(0,0,0,0.14)"
                : "0 1px 2px rgba(44, 44, 44, 0.06)";
const shadowMd = shadowStyle === "none"     ? "none"
                : shadowStyle === "dramatic" ? "0 24px 60px rgba(0,0,0,0.28)"
                : "0 12px 36px rgba(120, 95, 70, 0.12)";
const shadowLg = shadowStyle === "none"     ? "none"
                : shadowStyle === "dramatic" ? "0 40px 100px rgba(0,0,0,0.45)"
                : "0 28px 80px rgba(120, 95, 70, 0.18)";
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    {sitePlan.logo && <link rel="icon" type="image/jpeg" href={sitePlan.logo} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={googleFontsUrl} />
    <title>{pageTitle}</title>
    <style is:global define:vars={{
      primary: theme.primary || "#b8936a",
      "primary-dark": theme.primary_dark || "#8d6e4f",
      secondary: theme.secondary || "#2c2c2c",
      accent: theme.accent || "#f5ede3",
      background: theme.background || "#faf8f5",
      text: theme.text || "#2c2c2c",
      "font-heading": headingStack,
      "font-body": bodyStack,
      "card-radius": cardRadius,
      "btn-radius": buttonRadius,
      "section-pad": sectionPadding,
      "heading-weight": headingWeight,
      "shadow-sm": shadowSm,
      "shadow-md": shadowMd,
      "shadow-lg": shadowLg,
    }}>
      :root {
        --primary: var(--primary);
        --primary-dark: var(--primary-dark);
        --secondary: var(--secondary);
        --accent: var(--accent);
        --background: var(--background);
        --text: var(--text);
      }
    </style>
  </head>
  <body data-personality={personality.name || "soft"}>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
  </body>
</html>
