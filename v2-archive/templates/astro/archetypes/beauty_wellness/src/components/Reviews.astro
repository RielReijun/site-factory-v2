---
const { reviews, heading } = Astro.props;
if (!reviews || !reviews.items || reviews.items.length === 0) return null;
const title = heading?.title || reviews.title || "Wat klanten ervaren";
const eyebrow = heading?.eyebrow || "Vertrouwen";
const lead = heading?.lead;
const note = reviews.note;
---
<section class="section" id="reviews">
  <div class="container">
    <header class="section-header">
      <div class="section-eyebrow">{eyebrow}</div>
      <h2>{title}</h2>
      {lead && <p>{lead}</p>}
    </header>
    <div class="proof-grid">
      {reviews.items.map((item) => (
        <article class="proof-card">
          <p class="proof-quote">{item.quote}</p>
          {item.attribution && <span class="proof-meta">{item.attribution}</span>}
        </article>
      ))}
    </div>
    {note && <p class="proof-note">{note}</p>}
  </div>
</section>
