---
const { content } = Astro.props;
if (!content) return null;
const bullets = content.bullets || [];
---
<section class="section page-content-section">
  <div class="container page-content-grid">
    <aside class="page-content-aside">
      {content.eyebrow && <div class="section-eyebrow">{content.eyebrow}</div>}
      <h2>{content.title}</h2>
      {content.lead && <p class="page-content-lead">{content.lead}</p>}
    </aside>
    <div class="page-content-main">
      {content.body && <p>{content.body}</p>}
      {bullets.length > 0 && (
        <ul class="page-content-list">
          {bullets.map((item) => <li>{item}</li>)}
        </ul>
      )}
      {content.note && <p class="page-content-note">{content.note}</p>}
    </div>
  </div>
</section>
