---
const { about, heading } = Astro.props;
if (!about) return null;
const title = heading?.title || about.title || "Over ons";
const eyebrow = heading?.eyebrow || "Persoonlijk";
const body = about.body;
const signature = about.signature;
const image = about.image;
---
<section class="section section-tinted" id="over">
  <div class="container">
    <div class="about-grid">
      {image && (
        <div class="about-image">
          <img src={image} alt={title} loading="lazy" />
        </div>
      )}
      <div class="about-body">
        <div class="section-eyebrow">{eyebrow}</div>
        <h2>{title}</h2>
        {body && <p>{body}</p>}
        {signature && <blockquote class="about-signature">{signature}</blockquote>}
      </div>
    </div>
  </div>
</section>
