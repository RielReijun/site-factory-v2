---
const { products } = Astro.props;
if (!products?.title) return null;
---
<section class="section detail-section">
  <div class="container product-story">
    <div>
      <div class="section-eyebrow">Productlijn</div>
      <h2>{products.title}</h2>
      {products.lead && <p class="product-lead">{products.lead}</p>}
    </div>
    <div class="product-panel">
      {products.body && <p>{products.body}</p>}
      {(products.bullets || []).length > 0 && (
        <ul>
          {products.bullets.map((item) => <li>{item}</li>)}
        </ul>
      )}
    </div>
  </div>
</section>
