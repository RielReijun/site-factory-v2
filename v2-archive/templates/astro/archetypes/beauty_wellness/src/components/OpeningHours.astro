---
const { openingHours, contact, heading } = Astro.props;
if (!openingHours) return null;
const title = heading?.title || "Openingstijden";
const eyebrow = heading?.eyebrow || "Plannen";
const items = openingHours.items || [];
const fallback = openingHours.fallback;
---
<section class="section" id="openingstijden">
  <div class="container">
    <header class="section-header">
      <div class="section-eyebrow">{eyebrow}</div>
      <h2>{title}</h2>
    </header>
    <div class="hours-wrap">
      <div>
        {items.length > 0 ? (
          <ul class="hours-list">
            {items.map((row) => (
              <li>
                <span class="day">{row.day}</span>
                <span class="time">{row.time}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="hours-fallback">{fallback}</p>
        )}
      </div>
      <div>
        {contact?.address && <p><strong>Adres</strong><br />{contact.address}</p>}
        {contact?.phone && <p><strong>Telefoon</strong><br /><a href={`tel:${contact.phone}`}>{contact.phone_display || contact.phone}</a></p>}
        {contact?.email && <p><strong>E-mail</strong><br /><a href={`mailto:${contact.email}`}>{contact.email}</a></p>}
      </div>
    </div>
  </div>
</section>
