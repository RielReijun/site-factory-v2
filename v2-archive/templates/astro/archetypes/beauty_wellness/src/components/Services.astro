---
const { services, heading } = Astro.props;
if (!services || services.length === 0) return null;
const title = heading?.title || "Behandelingen";
const eyebrow = heading?.eyebrow || "Diensten";
const lead = heading?.lead;
---
<section class="section" id="diensten">
  <div class="container">
    <header class="section-header">
      <div class="section-eyebrow">{eyebrow}</div>
      <h2>{title}</h2>
      {lead && <p>{lead}</p>}
    </header>
    <div class="services-grid">
      {services.map((service) => (
        <article class="service-card">
          {service.image && (
            <div class="service-card-image">
              <img src={service.image} alt={service.title} loading="lazy" />
            </div>
          )}
          <div class="service-card-body">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            {service.href && <a class="service-card-link" href={service.href}>Lees meer &rarr;</a>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
