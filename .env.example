# Site Factory configuration
# Copy to .env and fill in real values. Never commit .env.

# Anthropic API mode
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
USE_CLAUDE_MAX=true

# Optional: Anthropic Admin API for usage/cost dashboard
ANTHROPIC_ADMIN_KEY=

# Dashboard/bridge protection.
# Strongly recommended before exposing via Tailscale, Cloudflare Tunnel, or LAN.
# Open once with: http://HOST:8181/?token=YOUR_TOKEN
DASHBOARD_TOKEN=
BRIDGE_TOKEN=

# GitHub deploy
GITHUB_TOKEN=
GITHUB_USERNAME=

# Cloudflare Pages deploy
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Agency info
AGENCY_NAME=
AGENCY_EMAIL=
AGENCY_PHONE=
AGENCY_URL=
