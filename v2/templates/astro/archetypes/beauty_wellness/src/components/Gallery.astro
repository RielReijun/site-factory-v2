---
const { gallery, heading, variant } = Astro.props;
if (!gallery || gallery.length === 0) return null;
const title = heading?.title || "Sfeer in de salon";
const eyebrow = heading?.eyebrow || "Galerij";
const lead = heading?.lead;
// Variant: "grid" (default; 4-up met eerste tall), "masonry" (varierende
// hoogtes), "strip" (3-up smal, voor weinig fotos).
const mode = variant || "grid";
const gridClass = mode === "masonry" ? "gallery-masonry" : mode === "strip" ? "gallery-strip" : "gallery-grid";
---
<section class="section section-tinted" id="galerij">
  <div class="container">
    <header class="section-header">
      <div class="section-eyebrow">{eyebrow}</div>
      <h2>{title}</h2>
      {lead && <p>{lead}</p>}
    </header>
    <div class={gridClass}>
      {gallery.map((item, index) => {
        const tall = mode === "grid" && index === 0;
        const wide = mode === "masonry" && (index % 5 === 2);
        const cls = `gallery-item${tall ? " tall" : ""}${wide ? " wide" : ""}`;
        return (
          <figure class={cls}>
            <img src={item.src} alt={item.alt || "Sfeerfoto"} loading="lazy" />
          </figure>
        );
      })}
    </div>
  </div>
</section>
