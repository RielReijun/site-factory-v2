---
import BaseLayout from "../layouts/BaseLayout.astro";
import sitePlan from "../data/sitePlan.json";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Gallery from "../components/Gallery.astro";
import Reviews from "../components/Reviews.astro";
import OpeningHours from "../components/OpeningHours.astro";
import About from "../components/About.astro";
import ContactCta from "../components/ContactCta.astro";
import Stats from "../components/Stats.astro";

const homePage = (sitePlan.pages || []).find((p) => !p.slug) || {};
const baseSections = homePage.sections || ["services", "about", "gallery", "reviews", "openingHours", "contactCta"];
// Stats automatisch invoegen direct na hero als stats-data aanwezig is
const hasStats = sitePlan.stats && sitePlan.stats.length >= 2;
const sections = hasStats ? ["stats", ...baseSections] : baseSections;
---
<BaseLayout title={sitePlan.company_name} description={sitePlan.tagline}>
  <Hero hero={sitePlan.hero} sitePlan={sitePlan} />
  {sections.map((name) => {
    if (name === "stats")        return <Stats stats={sitePlan.stats} heading={sitePlan.headings?.stats} />;
    if (name === "services")     return <Services services={sitePlan.services} heading={sitePlan.headings?.services} />;
    if (name === "about")        return <About about={sitePlan.about} heading={sitePlan.headings?.about} />;
    if (name === "gallery")      return <Gallery gallery={sitePlan.gallery} heading={sitePlan.headings?.gallery} variant={sitePlan.variants?.gallery} />;
    if (name === "reviews")      return <Reviews reviews={sitePlan.reviews} heading={sitePlan.headings?.reviews} />;
    if (name === "openingHours") return <OpeningHours openingHours={sitePlan.openingHours} contact={sitePlan.contact} heading={sitePlan.headings?.openingHours} />;
    if (name === "contactCta")   return <ContactCta contactCta={sitePlan.contactCta} contact={sitePlan.contact} social={sitePlan.social} />;
    return null;
  })}
</BaseLayout>
