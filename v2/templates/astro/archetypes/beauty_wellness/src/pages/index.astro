---
import BaseLayout from "../layouts/BaseLayout.astro";
import sitePlan from "../data/sitePlan.json";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Gallery from "../components/Gallery.astro";
import Reviews from "../components/Reviews.astro";
import OpeningHours from "../components/OpeningHours.astro";
import About from "../components/About.astro";
import ContactCta from "../components/ContactCta.astro";
import Stats from "../components/Stats.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import FeaturedService from "../components/FeaturedService.astro";
import MapSection from "../components/MapSection.astro";
import QuoteCallout from "../components/QuoteCallout.astro";

const homePage = (sitePlan.pages || []).find((p) => !p.slug) || {};
const baseSections = homePage.sections || ["services", "about", "gallery", "reviews", "openingHours", "contactCta"];
// Conditionele extra-secties uit inventory-data
const hasStats = sitePlan.stats && sitePlan.stats.length >= 2;
const hasProcess = sitePlan.process && sitePlan.process.length >= 3;
const hasFeatured = sitePlan.featured && sitePlan.featured.title;
const hasMap = sitePlan.contact && sitePlan.contact.address && sitePlan.contact.address.length >= 12;
const hasCallout = sitePlan.quoteCallout && sitePlan.quoteCallout.quote;

let sections = [...baseSections];
// Stats vlak na hero
if (hasStats) sections = ["stats", ...sections];
// Featured-service tussen services en about
if (hasFeatured) {
  const idx = sections.indexOf("services");
  if (idx >= 0) sections.splice(idx + 1, 0, "featured");
  else sections.push("featured");
}
// QuoteCallout tussen about en gallery (alleen als 2e signature beschikbaar)
if (hasCallout) {
  const aIdx = sections.indexOf("about");
  if (aIdx >= 0) sections.splice(aIdx + 1, 0, "quoteCallout");
}
// Process-steps voor contactCta
if (hasProcess) {
  const cidx = sections.indexOf("contactCta");
  if (cidx >= 0) sections.splice(cidx, 0, "process");
  else sections.push("process");
}
// MapSection vlak voor contactCta (na process als die er is)
if (hasMap) {
  const cidx = sections.indexOf("contactCta");
  if (cidx >= 0) sections.splice(cidx, 0, "map");
  else sections.push("map");
}
---
<BaseLayout title={sitePlan.company_name} description={sitePlan.tagline}>
  <Hero hero={sitePlan.hero} sitePlan={sitePlan} />
  {sections.map((name) => {
    if (name === "stats")        return <Stats stats={sitePlan.stats} heading={sitePlan.headings?.stats} />;
    if (name === "process")      return <ProcessSteps steps={sitePlan.process} heading={sitePlan.headings?.process} />;
    if (name === "featured")     return <FeaturedService service={sitePlan.featured} heading={sitePlan.headings?.featured} />;
    if (name === "map")          return <MapSection contact={sitePlan.contact} heading={sitePlan.headings?.map} />;
    if (name === "quoteCallout") return <QuoteCallout quote={sitePlan.quoteCallout?.quote} attribution={sitePlan.quoteCallout?.attribution} heading={sitePlan.headings?.quoteCallout} />;
    if (name === "services")     return <Services services={sitePlan.services} heading={sitePlan.headings?.services} />;
    if (name === "about")        return <About about={sitePlan.about} heading={sitePlan.headings?.about} />;
    if (name === "gallery")      return <Gallery gallery={sitePlan.gallery} heading={sitePlan.headings?.gallery} variant={sitePlan.variants?.gallery} />;
    if (name === "reviews")      return <Reviews reviews={sitePlan.reviews} heading={sitePlan.headings?.reviews} />;
    if (name === "openingHours") return <OpeningHours openingHours={sitePlan.openingHours} contact={sitePlan.contact} heading={sitePlan.headings?.openingHours} />;
    if (name === "contactCta")   return <ContactCta contactCta={sitePlan.contactCta} contact={sitePlan.contact} social={sitePlan.social} />;
    return null;
  })}
</BaseLayout>
